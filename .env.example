# Pipeline atual: salva o lead diretamente no Supabase.
LEAD_PIPELINE_MODE=direct

# URL do projeto Supabase. Exemplo: https://seu-projeto.supabase.co
SUPABASE_URL=

# Chave secreta somente do backend. Nunca enviar ao frontend nem versionar no GitHub.
SUPABASE_SECRET_KEY=

# Usado futuramente somente quando LEAD_PIPELINE_MODE=n8n.
N8N_WEBHOOK_URL=

# Opcional: origens permitidas, separadas por virgula.
ALLOWED_ORIGINS=

# Porta local do backend.
PORT=3000
